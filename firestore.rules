rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && 
             (request.auth.token.email == "venimurugesh@gmail.com" || request.auth.token.email == "jaisoulcm@gmail.com") && 
             request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Products: Everyone can read, only Admins can write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: Admins can read all, customers can create and read their own (if we had auth for customers)
    // For now, let's allow anyone to create an order (guest checkout) and admins to manage.
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Admins: Only Admins (or initial setup) can read/write the admin list
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Managed via console for security
    }

    // Reviews: Everyone can read, authenticated users can create, owners can update/delete
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidReview(incoming());
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && isValidReview(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'comment', 'updatedAt']);
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    function isValidReview(data) {
      return data.productId is string && 
             data.userId == request.auth.uid &&
             data.userName is string &&
             data.rating is number &&
             data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() <= 1000 &&
             data.createdAt is timestamp;
    }
  }
}
